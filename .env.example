# ==============================================================================
# Muneeb Amin - Portfolio Environment Variables Template
# ==============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env.local
#
# Vite requires all client-exposed variables to begin with the VITE_ prefix.

# Primary Canonical Domain URL (used for SEO & canonical headers)
VITE_SITE_URL=https://muneebamin.dev

# ------------------------------------------------------------------------------
# EmailJS Service Configuration (Contact Form)
# Get your free credentials from https://dashboard.emailjs.com/
# ------------------------------------------------------------------------------
# Your EmailJS Service ID (e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=service_muneeb

# Your EmailJS Template ID (e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=template_portfolio

# Your EmailJS Public Key / User ID (e.g. user_xxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
